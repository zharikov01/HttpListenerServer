<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HttpListenerAsync</AssemblyName>
    <RootNamespace>HttpListenerAsync</RootNamespace>
  </PropertyGroup>

  <!-- общая папка wwwroot решения автоматически копируется в папку исполняемого файла -->
  <ItemGroup>
    <None Include="..\wwwroot\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
